// spec v0.31.0: FORMAT and PRINTF fail loudly on a bad format, a count mismatch, or a value that
// is not a number under a pattern
function notAString() do
    return FORMAT(5)
end

function tooManyValues() do
    return FORMAT("{} {}", 1, 2, 3)
end

function tooFewValues() do
    return FORMAT("{}")
end

function oldSpec() do
    return FORMAT("{:.2f}", 1)
end

function positional() do
    return FORMAT("{1}", 1)
end

function badPattern() do
    return FORMAT("{0.0.0}", 1)
end

function spaces() do
    return FORMAT("{ 0.00 }", 1)
end

function leftToRight() do
    return FORMAT("{x} {", 1)
end

function unclosed() do
    return FORMAT("total {", 1)
end

function unmatched() do
    return FORMAT("a } b")
end

function textForNumber() do
    return FORMAT("{0.00}", "3.4")
end

function printfName() do
    PRINTF("{#,##0}", true)
    return 0
end

multi r do
    thread a: notAString()
    thread b: tooManyValues()
    thread c: tooFewValues()
    thread d: oldSpec()
    thread e: positional()
    thread f: badPattern()
    thread g: spaces()
    thread h: leftToRight()
    thread i: unclosed()
    thread j: unmatched()
    thread k: textForNumber()
    thread l: printfName()
end

loop key, v in r do
    PRINT(key, v.ok, v.value)
end

PRINT("before")
PRINTF("{} {}", 1)
PRINT("unreachable")
