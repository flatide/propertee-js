// Test 72: SHELL and SHELL_CTX are stubs in JS runtime

// 1. SHELL returns error
r = SHELL("echo hello")
if r.ok == false then
    PRINT("PASS shell stub")
else
    PRINT("FAIL shell stub")
end

// 2. SHELL_CTX returns error
ctx = SHELL_CTX("/tmp")
if ctx.ok == false then
    PRINT("PASS shell_ctx stub")
else
    PRINT("FAIL shell_ctx stub")
end

// 3. SHELL with context also returns error
ctx = SHELL_CTX("/tmp")
r = SHELL(ctx, "echo hello")
if r.ok == false then
    PRINT("PASS shell ctx stub")
else
    PRINT("FAIL shell ctx stub")
end
