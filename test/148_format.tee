// spec v0.31.0: FORMAT(format, values...) fills {} and {pattern} placeholders in order
PRINT(FORMAT("{}개, 평균 {0.00}점", 3, 3.4))

// {} is the value as PRINT shows it
PRINT(FORMAT("{}|{}|{}|{}|{}|{}", "text", 42, 2.5, true, null, 10 / 4))
PRINT(FORMAT("{} {} {}", [1, "a"], {"k": "v"}, {}))
PRINT(FORMAT("{} {}", TO_NUMBER("1e21"), 0.1 + 0.2))

// {pattern} is the number as the pattern draws it — 0 always writes a digit, # only when there is one
PRINT(FORMAT("[{0.00}] [{0}] [{0.000}] [{0.0}]", 3.4, 2.5, 7, 1.25))
PRINT(FORMAT("[{#,##0}] [{#,##0.00}] [{0,000}] [{000}]", 1234567, 1234567.891, 7, 42))
PRINT(FORMAT("[{0.0%}] [{0%}] [{0.##}] [{0.##}] [{0.0#}]", 0.4567, 0.145, 3, 3.14159, 3.1))
PRINT(FORMAT("[{0.00}] [{0}] [{000}] [{0.0}]", -3.456, -2.5, -7, -0.04))
PRINT(FORMAT("[{0.00}] [{0.0%}]", TO_NUMBER("1e21"), TO_NUMBER("1e300")))

// {{ and }} are literal braces
PRINT(FORMAT("{{}} {{{}}} }}{{ {{0.00}}", 5))

// FORMAT returns the text; nothing is printed
line = FORMAT("{#,##0.00}원", 1234567.891)
PRINT(line, LEN(line), TYPE_OF(line))
