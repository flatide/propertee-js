// spec v0.30.0: ROUND sends a tie away from zero, with or without digits (was: toward +infinity)
PRINT(ROUND(0.5), ROUND(1.5), ROUND(2.5), ROUND(-0.5), ROUND(-1.5), ROUND(-2.5))
PRINT(ROUND(2.5, 0), ROUND(-2.5, 0), ROUND(0.125, 2), ROUND(-0.125, 2))
PRINT(ROUND(1250, -2), ROUND(-1250, -2), ROUND(-1.005, 2), ROUND(-2.675, 2))

// just under a tie stays under: 0.49999999999999994 is the largest double below 0.5
PRINT(ROUND(0.49999999999999994), ROUND(-0.49999999999999994))

// symmetric: ROUND(-x, d) is -ROUND(x, d)
PRINT(ROUND(-1.005, 2) == -ROUND(1.005, 2), ROUND(-2.5) == -ROUND(2.5))

// without digits ROUND is still an integer inside the integer range (spec v0.33.0); the
// largest tie a decimal holds is 4503599627370495.5
PRINT(ROUND(4503599627370495.5), ROUND(-4503599627370495.5), ROUND(9007199254740991.0))
