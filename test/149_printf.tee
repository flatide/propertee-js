// spec v0.30.0: PRINTF(format, values...) prints one line, PRINT(FORMAT(format, values...));
// the placeholders are spec v0.31.0's
PRINTF("합계: {#,##0}원", 1234567)
PRINTF("평균 {0.00}점", 3.456)
PRINTF("{0.0}", TRUNC(3.48, 1))
PRINTF("no placeholders")

// it returns {}
r = PRINTF("{} + {} = {}", 1, 2, 1 + 2)
PRINT(r, TYPE_OF(r))

// PRINTF(f, ...) prints what PRINT(FORMAT(f, ...)) prints
PRINT(FORMAT("{000}|{0.0%}|", 1, 0.5))
PRINTF("{000}|{0.0%}|", 1, 0.5)

// in a thread
function report(name, v) do
    PRINTF("{}: {0.00}", name, v)
    return ROUND(v, 2)
end

multi res do
    thread a: report("a", 1.005)
end
PRINT(res.a.value)
